{
  "name": "@vorsakha/pi-native-subagents",
  "version": "0.1.0",
  "description": "Native multi-harness subagents and sandboxed workflows for Pi.",
  "type": "module",
  "main": "extensions/subagents/index.ts",
  "license": "MIT",
  "author": "@vorsakha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorsakha/pi-native-subagents.git"
  },
  "bugs": {
    "url": "https://github.com/vorsakha/pi-native-subagents/issues"
  },
  "homepage": "https://github.com/vorsakha/pi-native-subagents#readme",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagents",
    "workflows",
    "claude-code",
    "codex"
  ],
  "pi": {
    "extensions": [
      "./extensions/subagents/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "files": [
    "extensions",
    "src",
    "scripts",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run typecheck",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/test.mjs",
    "pack:check": "npm pack --dry-run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run pack:check",
    "smoke": "node scripts/live-smoke.mjs",
    "smoke:pi": "node scripts/live-smoke.mjs pi",
    "smoke:claude": "node scripts/live-smoke.mjs claude",
    "smoke:codex": "node scripts/live-smoke.mjs codex",
    "smoke:access": "node scripts/live-smoke.mjs access",
    "smoke:access:claude": "node scripts/live-smoke.mjs access claude",
    "smoke:access:codex": "node scripts/live-smoke.mjs access codex",
    "format": "prettier --write src extensions tests scripts eslint.config.js",
    "format:check": "prettier --check src extensions tests scripts eslint.config.js",
    "lint": "eslint src extensions tests scripts eslint.config.js --max-warnings=0",
    "lint:fix": "eslint src extensions tests scripts eslint.config.js --fix"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.210",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-codemode": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "acorn": "8.15.0",
    "quickjs-wasi": "3.6.2",
    "workflow-pi-ai": "npm:@earendil-works/pi-ai@1.3.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.3",
    "@earendil-works/pi-coding-agent": "0.84.3",
    "@earendil-works/pi-tui": "0.84.3",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "~3.10.1",
    "typebox": "1.1.38",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.74.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
